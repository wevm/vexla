{
  "parseFile": [
    {
      "name": "every type, tags on separate lines and on one line",
      "text": "# Flags of the checkout service.\n\n# Use the new checkout flow.\n# @type {boolean}\n# @public\nNEW_CHECKOUT=false\n\n# Pricing page variant.\n# @type {'a' | 'b' | 'c'}\nPRICING=a\n\n# @type {number}\nRETRIES=3\n\n# @type {json}\nLIMITS={\"requests\":100}\n\n# Show the maintenance banner.\n# @type {boolean} @build @public @expires 2027-01-31\nMAINTENANCE_BANNER=false\n\n# @type {string}\nTITLE=\"Hello, world\"\n",
      "output": {
        "LIMITS": {
          "build": false,
          "default": {
            "requests": 100
          },
          "public": false,
          "type": "json"
        },
        "MAINTENANCE_BANNER": {
          "build": true,
          "default": false,
          "description": "Show the maintenance banner.",
          "expires": "2027-01-31",
          "public": true,
          "type": "boolean"
        },
        "NEW_CHECKOUT": {
          "build": false,
          "default": false,
          "description": "Use the new checkout flow.",
          "public": true,
          "type": "boolean"
        },
        "PRICING": {
          "build": false,
          "default": "a",
          "description": "Pricing page variant.",
          "options": ["a", "b", "c"],
          "public": false,
          "type": "select"
        },
        "RETRIES": {
          "build": false,
          "default": 3,
          "public": false,
          "type": "number"
        },
        "TITLE": {
          "build": false,
          "default": "Hello, world",
          "public": false,
          "type": "string"
        }
      }
    },
    {
      "name": "description over two lines, and double quoted select options",
      "text": "# Pricing page\n# variant.\n# @type {\"a\" | \"b\"}\nPRICING='b'\n",
      "output": {
        "PRICING": {
          "build": false,
          "default": "b",
          "description": "Pricing page variant.",
          "options": ["a", "b"],
          "public": false,
          "type": "select"
        }
      }
    },
    {
      "name": "a type inferred from the default",
      "text": "# Use the new checkout flow.\n# @public\nNEW_CHECKOUT=false\n\nRETRIES=3\n\nRATIO=-0.5\n\nLIMITS={\"requests\":100}\n\nHOSTS=[\"a\",\"b\"]\n\nTITLE=Hello\n\nVERSION=1e3\n\nEMPTY=\n",
      "output": {
        "EMPTY": {
          "build": false,
          "default": "",
          "public": false,
          "type": "string"
        },
        "HOSTS": {
          "build": false,
          "default": ["a", "b"],
          "public": false,
          "type": "json"
        },
        "LIMITS": {
          "build": false,
          "default": {
            "requests": 100
          },
          "public": false,
          "type": "json"
        },
        "NEW_CHECKOUT": {
          "build": false,
          "default": false,
          "description": "Use the new checkout flow.",
          "public": true,
          "type": "boolean"
        },
        "RATIO": {
          "build": false,
          "default": -0.5,
          "public": false,
          "type": "number"
        },
        "RETRIES": {
          "build": false,
          "default": 3,
          "public": false,
          "type": "number"
        },
        "TITLE": {
          "build": false,
          "default": "Hello",
          "public": false,
          "type": "string"
        },
        "VERSION": {
          "build": false,
          "default": "1e3",
          "public": false,
          "type": "string"
        }
      }
    },
    {
      "name": "a blank line detaches the comment",
      "text": "# @type {string}\n\nBETA=false\n",
      "output": {
        "BETA": {
          "build": false,
          "default": false,
          "public": false,
          "type": "boolean"
        }
      }
    },
    {
      "name": "unknown type",
      "text": "# @type {date}\nBETA=2026-01-01\n",
      "error": "BETA"
    },
    {
      "name": "unknown tag",
      "text": "# @type {boolean} @owner\nBETA=false\n",
      "error": "BETA"
    },
    {
      "name": "default of the wrong type",
      "text": "# @type {number}\nRETRIES=three\n",
      "error": "RETRIES"
    },
    {
      "name": "default outside options",
      "text": "# @type {'a' | 'b'}\nPRICING=c\n",
      "error": "PRICING"
    },
    {
      "name": "invalid JSON default",
      "text": "# @type {json}\nLIMITS={requests\n",
      "error": "LIMITS"
    },
    {
      "name": "invalid expiry",
      "text": "# @type {boolean} @expires soon\nBETA=false\n",
      "error": "BETA"
    },
    {
      "name": "tag with a value that takes none",
      "text": "# @type {boolean} @public yes\nBETA=false\n",
      "error": "BETA"
    },
    {
      "name": "invalid line",
      "text": "# @type {boolean}\nBETA false\n",
      "error": "line 2"
    },
    {
      "name": "declared twice",
      "text": "# @type {boolean}\nBETA=false\n# @type {boolean}\nBETA=true\n",
      "error": "BETA"
    },
    {
      "name": "a variable with any name",
      "text": "# @type {boolean}\nfeature_lowercase=true\n",
      "output": {
        "feature_lowercase": {
          "build": false,
          "default": true,
          "public": false,
          "type": "boolean"
        }
      }
    }
  ]
}
