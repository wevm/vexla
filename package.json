{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "check": "vp check --fix",
    "check:types": "tsc",
    "dev": "zile dev",
    "docs:build": "pnpm --filter docs build",
    "docs:dev": "pnpm --filter docs dev",
    "postinstall": "zile dev",
    "test": "vp test"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zile": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "[!start-pkg]": "",
  "name": "vexla",
  "description": "Feature flags for trunk-based development.",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wevm/vexla.git"
  },
  "sideEffects": false,
  "bin": {
    "vexla": "./dist/cli/bin.js",
    "vexla.src": "./src/cli/bin.ts"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "src": "./src/hono/index.ts",
      "types": "./dist/hono/index.d.ts",
      "default": "./dist/hono/index.js"
    },
    "./node": {
      "src": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./react": {
      "src": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "src": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./vite": {
      "src": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./zile": {
      "src": "./src/zile/index.ts",
      "types": "./dist/zile/index.d.ts",
      "default": "./dist/zile/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test-d.ts",
    "!src/**/*.test.ts"
  ],
  "dependencies": {
    "incur": "catalog:"
  },
  "peerDependencies": {
    "hono": "catalog:peers",
    "react": "catalog:peers",
    "typescript": "catalog:peers",
    "vite": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
